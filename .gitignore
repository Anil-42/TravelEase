# ==============================================================================
# TravelEase — Root Git Ignore Configuration
# Covers Spring Boot Backend, React / Vite Frontend, IDEs, and OS Artifacts
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Secret Exclusions (CRITICAL)
# ------------------------------------------------------------------------------
*.env
*.env.*
!.env.example
!*.env.example
*.pem
*.key
*.pkcs12
*.pfx
*.p12
*.jks
*.keystore

# ------------------------------------------------------------------------------
# 2. Spring Boot Backend Exclusions
# ------------------------------------------------------------------------------
**/target/
target/
*.class
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Maven Wrapper & Build Rules (Explicitly Tracked)
!**/mvnw
!**/mvnw.cmd
!**/.mvn/wrapper/maven-wrapper.properties
!**/.mvn/wrapper/maven-wrapper.jar
!**/pom.xml

# Local Spring / Maven Cache
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar.part

# ------------------------------------------------------------------------------
# 3. React / Vite Frontend Exclusions
# ------------------------------------------------------------------------------
**/node_modules/
node_modules/
**/dist/
dist/
dist-ssr/
*.local

# Frontend Package Rules (Explicitly Tracked)
!**/package.json
!**/package-lock.json

# ------------------------------------------------------------------------------
# 4. Logs & Runtime Artifacts
# ------------------------------------------------------------------------------
*.log
logs/
**/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 5. Database Dumps & Local Data
# ------------------------------------------------------------------------------
*.sql.gz
*.sql.bak
*.dump
local_backup/
*.db
*.sqlite

# Keep Authoritative Migrations & Reference Schema
!**/src/main/resources/db/migration/*.sql
!database/schema.sql

# ------------------------------------------------------------------------------
# 6. IDEs & Developer Tools
# ------------------------------------------------------------------------------
# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/
!**/src/main/**

# Eclipse
.project
.classpath
.settings/
bin/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Miscellaneous Editors
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# 7. Operating System Artifacts
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
