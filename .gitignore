# ==============================================================================
# TravelEase — Root Git Ignore Configuration
# Covers Spring Boot Backend, React / Vite Frontend, IDEs, and OS Artifacts
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Secret Exclusions (CRITICAL)
# ------------------------------------------------------------------------------
.env
**/.env
*.env
*.env.*
!.env.example
!*.env.example
!**/.env.example

# Local Secrets, Keys & Overrides
*.pem
*.key
*.pkcs12
*.pfx
*.p12
*.jks
*.keystore
*.crt
*.der
*.secret
*credentials*.json
**/application-local*.yml
**/application-local*.yaml
**/application-local*.properties
**/application-secret*.yml
**/application-secret*.yaml
**/application-secret*.properties

# ------------------------------------------------------------------------------
# 2. Spring Boot Backend Exclusions
# ------------------------------------------------------------------------------
**/target/
target/
*.class
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
.flattened-pom.xml
dependency-reduced-pom.xml
hs_err_pid*
replay_pid*
*.hprof

# Maven Wrapper & Build Rules (Explicitly Tracked)
!**/mvnw
!**/mvnw.cmd
!**/.mvn/wrapper/maven-wrapper.properties
!**/.mvn/wrapper/maven-wrapper.jar
!**/pom.xml

# Local Spring / Maven Cache
.mvn/timing.properties
**/.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar.part
**/.mvn/wrapper/maven-wrapper.jar.part

# ------------------------------------------------------------------------------
# 3. React / Vite Frontend Exclusions
# ------------------------------------------------------------------------------
**/node_modules/
node_modules/
**/dist/
dist/
dist-ssr/
**/.vite/
.vite/
**/.vite-temp/
**/coverage/
coverage/
*.tsbuildinfo
*.local

# Frontend Package Rules (Explicitly Tracked)
!**/package.json
!**/package-lock.json

# ------------------------------------------------------------------------------
# 4. Logs & Runtime Artifacts
# ------------------------------------------------------------------------------
*.log
logs/
**/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 5. Database Dumps & Local Data
# ------------------------------------------------------------------------------
*.sql.gz
*.sql.bak
*.dump
local_backup/
*.db
*.sqlite
*.sqlite3

# Keep Authoritative Migrations & Reference Schema
!**/src/main/resources/db/migration/*.sql
!database/schema.sql

# ------------------------------------------------------------------------------
# 6. IDEs & Developer Tools
# ------------------------------------------------------------------------------
# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
/out/
backend/out/

# Eclipse
.project
.classpath
.settings/
/bin/
backend/bin/

# Visual Studio Code (ignore local settings/launch files that may hold env secrets)
.vscode/*
!.vscode/extensions.json
!.vscode/tasks.json

# Miscellaneous Editors
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# 7. Operating System Artifacts
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
