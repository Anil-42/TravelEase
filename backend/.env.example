# ==============================================================================
# TravelEase Backend Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' (Spring Boot loads optional:file:.env[.properties])
# OR export these environment variables in your terminal session.
# NEVER commit your actual '.env' file or production credentials to Git.

# Database Configuration (MySQL 8)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=travelease_flyway
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# Connection Pool & Concurrency Tuning
DB_POOL_MAX_SIZE=30
DB_POOL_MIN_IDLE=10
SERVER_TOMCAT_THREADS_MAX=200

# JWT Security Configuration (HMAC-SHA256 / SHA384 / SHA512 - min 32 bytes)
JWT_SECRET=your_secure_random_jwt_secret_key_at_least_32_bytes_long
JWT_EXPIRATION_MS=86400000

# CORS & Allowed Frontend Origins (comma-separated URLs)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
FRONTEND_BASE_URL=http://localhost:5173

# Initial Administrator Bootstrap (Created on first startup if no admin exists)
TRAVELEASE_ADMIN_USERNAME=admin
TRAVELEASE_ADMIN_EMAIL=admin@travelease.com
TRAVELEASE_ADMIN_PASSWORD=your_secure_admin_password_here
TRAVELEASE_ADMIN_RESET_PASSWORD=false
TRAVELEASE_ADMIN_FORCE_PASSWORD_CHANGE=false

# Caching & Rate Limiting (Use 'caffeine' standalone or 'redis' for multi-node scaling)
CACHE_TYPE=caffeine
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORE=caffeine
# Comma-separated trusted reverse proxy IPs or CIDRs allowed to supply X-Forwarded-For (empty = ignore X-Forwarded-For)
RATE_LIMIT_TRUSTED_PROXIES=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Optional Transactional Email (Resend API)
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=onboarding@resend.dev
